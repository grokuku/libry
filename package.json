{
  "name": "libry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Libry — service web central de l'écosystème holaf : bibliothèque de documents, recherche et (à venir) lecture de page, crawl, capture.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:vendor": "node scripts/check-holaf-vendor.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
