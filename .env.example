# ── Libry — variables d'environnement ──
# Copier en .env et adapter. Toutes les variables propres à Libry sont préfixées
# LIBRY_* ; CHROMIUM_PATH et WEBCLAW_* restent neutres (contrat inter-services).

# ── Serveur ──
LIBRY_HOST=0.0.0.0
LIBRY_PORT=3007

# ── Données ──
# Répertoire racine des données persistantes (volume docker).
LIBRY_DATA_DIR=/app/data
# Répertoire de la bibliothèque (index.json + tools/*.json).
LIBRY_DOCS_DIR=/app/data/docs
# Fichier des clés API.
LIBRY_KEYS_FILE=/app/data/libry-keys.json

# ── Sécurité / accès ──
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune origine
# cross-origin autorisée (l'API reste accessible en same-origin / server-to-server).
LIBRY_ALLOWED_ORIGINS=
# Limite de requêtes par minute et par IP.
LIBRY_RATE_LIMIT_PER_MIN=600
# Durée de vie des sessions d'administration, en heures (défaut 12). Le secret de
# signature des sessions et le hash du mot de passe admin sont auto-générés dans
# $LIBRY_DATA_DIR/config.json (0600) — jamais exposés et jamais dans ce fichier env.
LIBRY_SESSION_TTL_HOURS=12
# Clés historiques (préfixe « lib-… ») à accepter sans être présentes dans le
# fichier de clés — utilisé pour la clé de Yuki lors de la migration. Vide = aucune.
LIBRY_LEGACY_KEYS=
# Clés (libry_… ou lib-…) marquées administrateur, séparées par des virgules.
# Elles donnent accès à /keys sans passer par la boucle locale.
LIBRY_ADMIN_KEYS=
# Liste blanche de chemins (séparés par des virgules) scannés par POST /update.
# Vide = POST /update répond 501.
LIBRY_UPDATE_CWDS=

# ── Adresses internes autorisées (anti-SSRF) ──
# VIDE PAR DÉFAUT = aucune adresse interne n'est joignable (loopback, 10/8,
# 172.16/12, 192.168/16, 100.64/10, fc00::/7 refusés). Ces deux réglages se
# configurent normalement dans l'interface (Réglages → Adresses internes
# autorisées) ; une valeur NON VIDE ici est prioritaire et verrouille l'édition.
# Noms d'hôtes internes autorisés (séparés par des virgules) :
LIBRY_SSRF_ALLOWED_HOSTS=
# Plages d'adresses autorisées (CIDR, séparées par des virgules) :
LIBRY_SSRF_ALLOWED_CIDRS=

# ── Journalisation ──
LIBRY_LOG_LEVEL=info

# ── Capture d'écran (Lot 5) ──
# Répertoire des captures (PNG + méta JSON). Défaut : $LIBRY_DATA_DIR/shots.
LIBRY_SHOTS_DIR=/app/data/shots
# Captures simultanées autorisées (défaut 2).
LIBRY_SHOT_CONCURRENCY=2
# Demandes pouvant attendre un slot avant rejet HTTP 429 (défaut 4). 0 = aucune attente.
LIBRY_SHOT_QUEUE_MAX=4
# Durée de vie des captures, en heures (défaut 168 h = 7 jours).
LIBRY_SHOT_TTL_HOURS=168
# Capture de HTML inline (opt-in). Désactivé par défaut ; `file://`/`htmlPath`
# ne sont JAMAIS exposés par la route publique.
LIBRY_SHOT_INLINE_HTML=false

# ── Moteur web (Lot 6) ──
# WebClaw : service TIERS intouchable (scrape/search/crawl/map/extract/batch).
# URL par défaut hors conteneur : http://localhost:3001 ; en docker-compose : http://webclaw:3000.
# ⚠️ WEBCLAW_API_KEY est REQUISE pour la recherche web : sans elle, chaque appel
# /v1/* répond 401 (« Invalid or missing API key ») → POST /search renvoie
# results:[] (bibliothèque locale d'abord, puis plus rien). Le journal serveur
# l'indique : « [web-search] WebClaw search unavailable: WebClaw request failed (HTTP 401) ».
# La clé de Pi-Web se lit sur le serveur dans
# /mnt/user/appdata-ssd/Pi-web/data/pi-appdata/webclaw-config.json (champ "apiKey").
# La clé est un SECRET (en-tête Authorization: Bearer, jamais exposée au client).
# Config possible aussi dans $LIBRY_DATA_DIR/webclaw-config.json — env PRIORITAIRE.
WEBCLAW_URL=http://webclaw:3000
WEBCLAW_API_KEY=
# Tavily : moteur de recherche de repli (2e étage de la cascade), SECRET.
# Config possible aussi dans $LIBRY_DATA_DIR/tavily-config.json — env PRIORITAIRE.
LIBRY_TAVILY_API_KEY=
# Timeouts par appel (ms) : dépassement → 504, sans fuite d'URL ni de clé.
LIBRY_WEBCLAW_TIMEOUT_MS=15000
LIBRY_TAVILY_TIMEOUT_MS=15000

# ── Chromium (capture d'écran) ──
# Chemin du binaire Chromium (sinon détection automatique par `which`).
CHROMIUM_PATH=/usr/bin/chromium
# ⚠️ Sous Docker (profil seccomp par défaut), le sandbox interne de Chromium ne
# peut PAS démarrer : unshare/clone des namespaces sont refusés (EPERM) sans
# CAP_SYS_ADMIN, et l'image n'a pas de helper SUID (chromium-sandbox). Les
# captures échouent alors « Screenshot capture failed » (détail dans docker logs).
# Deux options :
#   • LIBRY_CHROMIUM_NO_SANDBOX=true — simple ; le navigateur tourne SANS son
#     sandbox interne (une page hostile exploitée n'est plus isolée par
#     Chromium ; il reste la barrière du conteneur, utilisateur non-root) ;
#   • security_opt: seccomp=unconfined dans docker-compose.yml — garde le
#     sandbox de Chromium, retire le filtre seccomp Docker du conteneur.
LIBRY_CHROMIUM_NO_SANDBOX=false
