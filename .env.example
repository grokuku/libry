# ── Libry — variables d'environnement ──
# Copier en .env et adapter. Toutes les variables propres à Libry sont préfixées
# LIBRY_* ; CHROMIUM_PATH et WEBCLAW_* restent neutres (contrat inter-services).

# ── Serveur ──
LIBRY_HOST=0.0.0.0
LIBRY_PORT=3007

# ── Données ──
# Répertoire racine des données persistantes (volume docker).
LIBRY_DATA_DIR=/app/data
# Répertoire de la bibliothèque (index.json + tools/*.json).
LIBRY_DOCS_DIR=/app/data/docs
# Fichier des clés API.
LIBRY_KEYS_FILE=/app/data/libry-keys.json

# ── Sécurité / accès ──
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune origine
# cross-origin autorisée (l'API reste accessible en same-origin / server-to-server).
LIBRY_ALLOWED_ORIGINS=
# Limite de requêtes par minute et par IP.
LIBRY_RATE_LIMIT_PER_MIN=600
# Clés historiques (préfixe « lib-… ») à accepter sans être présentes dans le
# fichier de clés — utilisé pour la clé de Yuki lors de la migration. Vide = aucune.
LIBRY_LEGACY_KEYS=
# Clés (libry_… ou lib-…) marquées administrateur, séparées par des virgules.
# Elles donnent accès à /keys sans passer par la boucle locale.
LIBRY_ADMIN_KEYS=
# Liste blanche de chemins (séparés par des virgules) scannés par POST /update.
# Vide = POST /update répond 501.
LIBRY_UPDATE_CWDS=

# ── Journalisation ──
LIBRY_LOG_LEVEL=info

# ── Capture d'écran (Lot 5) ──
# Répertoire des captures (PNG + méta JSON). Défaut : $LIBRY_DATA_DIR/shots.
LIBRY_SHOTS_DIR=/app/data/shots
# Captures simultanées autorisées (défaut 2).
LIBRY_SHOT_CONCURRENCY=2
# Demandes pouvant attendre un slot avant rejet HTTP 429 (défaut 4). 0 = aucune attente.
LIBRY_SHOT_QUEUE_MAX=4
# Durée de vie des captures, en heures (défaut 168 h = 7 jours).
LIBRY_SHOT_TTL_HOURS=168
# Capture de HTML inline (opt-in). Désactivé par défaut ; `file://`/`htmlPath`
# ne sont JAMAIS exposés par la route publique.
LIBRY_SHOT_INLINE_HTML=false

# ── Dépendances web (lots ultérieurs — conservées neutres) ──
WEBCLAW_URL=http://webclaw:3000
WEBCLAW_API_KEY=
# Chemin du binaire Chromium (sinon détection automatique par `which`).
CHROMIUM_PATH=/usr/bin/chromium
# Repli : à activer UNIQUEMENT si la sandbox Chromium échoue sur le noyau hôte.
# L'image tourne en utilisateur non-root, donc `--no-sandbox` est retiré par défaut.
LIBRY_CHROMIUM_NO_SANDBOX=false
